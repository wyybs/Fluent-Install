# 每个仓库一份，放仓库根，文件名固定 .fork-sync.env
# ⚠️ 这个文件会被 shell `source`：路径一律用正斜杠 /，含空格或多值的**必须加引号**

UPSTREAM_URL="https://github.com/zhouchentao666/Fluent-Install.git"
UPSTREAM_HEAD="main"
LOCAL_BRANCH="local"
CORE_FILES="app/fluent_app.py backend/cai_backend.py backend/trainer_backend.py main.py"

# 可选
BASE_REF=""                       # 留空 = upstream/main
PORT_PREFIX="port:"
LOCAL_PREFIX="local:"
VERIFY_CMD="./.venv/Scripts/python.exe -m py_compile main.py app/fluent_app.py backend/cai_backend.py backend/trainer_backend.py"
INSTALL_CMD=""                    # 源码直接在仓库根运行，无装机步骤
INSTALL_DIR=""                    # 源码即安装副本，不需要漂移比对
HARDCODE_PATTERN="zhouchentao666" # 命中仅作提示；about/thanks 里的署名属正常归属
